# Copie para .env somente se quiser mudar os padrões. Não há segredo necessário.
API_PORT=8000
CHROMA_COLLECTION=qiskit_documentacao_multilingue
EMBEDDING_MODEL=sentence-transformers/paraphrase-multilingual-MiniLM-L12-v2
GROWUP_PERMITIR_DOWNLOAD=1
CHROMA_STARTUP_TIMEOUT=120
CHROMA_HTTP_TIMEOUT_SECONDS=30
API_TIMEOUT_SECONDS=60
# Deixe vazio até a equipe calibrar um limiar de relevância.
RAG_MAX_DISTANCE=
