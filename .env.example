# Copie para .env; Gemini e busca Google exigem chave e cota disponíveis.
API_PORT=8000
CHROMA_COLLECTION=qiskit_documentacao_multilingue
EMBEDDING_MODEL=sentence-transformers/paraphrase-multilingual-MiniLM-L12-v2
GROWUP_PERMITIR_DOWNLOAD=1
CHROMA_STARTUP_TIMEOUT=120
CHROMA_HTTP_TIMEOUT_SECONDS=30
API_TIMEOUT_SECONDS=60
# Deixe vazio até a equipe calibrar um limiar de relevância.
RAG_MAX_DISTANCE=

# Nunca publique a chave. Sem chave, /query retorna 503.
GEMINI_API_KEY=
GEMINI_MODEL=gemini-3.1-flash-lite
GEMINI_TIMEOUT_SECONDS=40
GROWUP_MAX_CONTEXT_CHARS=12000
QISKIT_TIMEOUT_SECONDS=30

FRONTEND_PORT=3000

# Busca ampla sob demanda, sem gravar resultados no Chroma.
WEB_SEARCH_ENABLED=1
GEMINI_WEB_MODEL=
# Atualiza o catálogo na primeira inicialização e a cada 7 dias.
KNOWLEDGE_AUTO_SYNC=1
KNOWLEDGE_SYNC_INTERVAL_SECONDS=604800
