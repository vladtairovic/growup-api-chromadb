  "components": {
    "schemas": {
      "Avaliacao": {
        "properties": {
          "case_id": {
            "type": "string",
            "maxLength": 100,
            "minLength": 1,
            "title": "Case Id"
          },
          "evaluator": {
            "type": "string",
            "maxLength": 100,
            "minLength": 2,
            "title": "Evaluator"
          },
          "ratings": {
            "items": {
              "$ref": "#/components/schemas/Nota"
            },
            "type": "array",
            "maxItems": 5,
            "minItems": 5,
            "title": "Ratings"
          },
          "critical_failure": {
            "type": "boolean",
            "title": "Critical Failure",
            "default": false
          },
          "critical_evidence": {
            "anyOf": [
              {
                "type": "string",
                "maxLength": 1000,
                "minLength": 5
              },
              {
                "type": "null"
              }
            ],
            "title": "Critical Evidence"
          }
        },
        "additionalProperties": false,
        "type": "object",
        "required": [
          "case_id",
          "evaluator",
          "ratings"
        ],
        "title": "Avaliacao"
